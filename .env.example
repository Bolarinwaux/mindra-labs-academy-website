# ─────────────────────────────────────────────
# Mindra Labs Academy – Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────

# Email provider for enquiry notifications (Resend recommended)
RESEND_API_KEY=your_resend_api_key_here

# WhatsApp contact number in E.164 format (no leading +)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Public site URL (used for OG metadata and canonical links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
